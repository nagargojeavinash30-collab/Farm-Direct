# Database
MONGODB_URI=mongodb://localhost:27017/farmers-market
# For production, use: mongodb+srv://username:password@cluster.mongodb.net/farmers-market

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Email (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Cloudinary (for image uploads - optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment Gateway (for future integration)
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
RAZORPAY_KEY_ID=key_xxxxx
RAZORPAY_KEY_SECRET=secret_xxxxx

# Groq API (for AI Chatbot)
GROQ_API_KEY=your-groq-api-key
